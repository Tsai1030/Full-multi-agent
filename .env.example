# 紫微斗數 Multi-Agent AI 系統 — 環境變數範例
# 複製本檔為 .env 並填入你的金鑰（.env 已被 git 忽略，不會上傳）
#
# 本系統僅需一把 Google Gemini API Key 即可運作（LLM + Embedding 皆用 Gemini）。
# 取得金鑰：https://aistudio.google.com/apikey

# =============================================================================
# 必填：Google Gemini
# =============================================================================
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini LLM（multi-agent 推理 / 解盤）
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.7

# Embedding（RAG 向量庫）
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# =============================================================================
# RAG 向量庫
# =============================================================================
# 知識庫來源（repo 根目錄的 chunks json，後端從 backend/ 啟動）
RAG_DATA_PATH=../zi_wei_dou_shu_rag_chunks.json
RAG_VECTOR_DB_PATH=./data/vector_db
RAG_COLLECTION_NAME=ziwei_knowledge
RAG_TOP_K=5
RAG_MIN_SCORE=0.3

# =============================================================================
# 選填：Web Search（留空則自動 fallback 至 DuckDuckGo）
# =============================================================================
TAVILY_API_KEY=

# =============================================================================
# LangGraph
# =============================================================================
GRAPH_MAX_ITERATIONS=6
GRAPH_RECURSION_LIMIT=25

# =============================================================================
# 選填：LangSmith 追蹤（觀察 multi-agent graph 流程）
# 到 https://smith.langchain.com 取得免費 API key，填入並把 TRACING 設 true
# =============================================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ziwei-multi-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# 應用程式
# =============================================================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000

# =============================================================================
# 選填：舊版供應商（預設停用，僅保留相容）
# =============================================================================
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
